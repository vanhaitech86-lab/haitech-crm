# ========================================================
# HAITECH CRM - AI ALL-IN-ONE CONFIGURATION
# ========================================================

# Chế độ hệ thống: 'demo' (mặc định với seed data hư cấu) hoặc 'production'
NEXT_PUBLIC_APP_ENV=demo
NEXT_PUBLIC_APP_NAME="HAITECH CRM"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Khóa bí mật JWT & Phiên làm việc
JWT_SECRET=super_secret_haitech_crm_jwt_key_32_characters_minimum
SESSION_EXPIRY_HOURS=24

# Cơ sở dữ liệu PostgreSQL & Redis (Sử dụng trong production)
# DATABASE_URL=postgresql://haitech_admin:strong_password@localhost:5432/haitech_crm?schema=public
# REDIS_URL=redis://localhost:6379

# ========================================================
# CẤU HÌNH AI & LLM PROVIDERS
# Lưu ý: Nếu để trống, hệ thống sẽ chạy ở chế độ MOCK AI
# và hiển thị cảnh báo hướng dẫn nhập API Key trong giao diện Cài Đặt.
# ========================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEFAULT_AI_MODEL="gpt-4o"

# ========================================================
# CẤU HÌNH ĐA KÊNH (OMNICHANNEL CONNECTORS)
# ========================================================

# 1. Telegram Bot (Production: Nhập token từ @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# 2. Meta (Facebook Messenger & Instagram Direct)
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=

# 3. Zalo Official Account (Zalo OA)
ZALO_OA_ID=
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_REFRESH_TOKEN=

# 4. TikTok Business Messaging
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# 5. SMTP / Email Outgoing
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HAITECH CRM <support@haitech.vn>"
